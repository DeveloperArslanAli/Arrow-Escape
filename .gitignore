# Godot 4.x .gitignore
.godot/
*.translation
*.import

# OS & Editor
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*~

# Export outputs & Gradle builds
/build/
/builds/
*.apk
*.aab
*.idsig
*.aar
android/build/.gradle/
android/build/build/
android/build/assetPackInstallTime/build/
android/build/assetPackInstallTime/src/main/assets/
android/build/libs/

# Keystores (keep repo public safe)
keystores/*.keystore

# Python
__pycache__/
*.pyc
tools/chunks/
