# Godot 4.x .gitignore
.godot/
*.translation
*.import

# OS & Editor
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
*~

# Export outputs & Gradle builds
build/
builds/
*.apk
*.aab
*.idsig
android/build/.gradle/
android/build/build/
android/build/assetPackInstallTime/build/

# Keystores (keep repo public safe)
keystores/*.keystore

# Python
__pycache__/
*.pyc
tools/chunks/
